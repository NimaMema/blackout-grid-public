# Copy to .env (never commit .env) to override the local development defaults.
# All values are optional: `docker compose up --build` works without a .env file.
# If you expose the stack beyond localhost, replace EVERY value with a strong,
# unique secret (for example: openssl rand -hex 32).

# Shared secret the API and worker use to authenticate each other's /internal/* calls.
BLACKOUT_INTERNAL_TOKEN=change-me

# RabbitMQ credentials (used by the broker container, the API and the worker).
RABBITMQ_USER=blackout
RABBITMQ_PASS=change-me
